// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subscription {
  id          String   @id @default(cuid())
  name        String
  // Integer minor units (e.g. cents) of `currency`, never a float. The number of
  // decimals per currency is derived in src/lib/money.ts (JPY 0, EUR 2, ...).
  priceMinor  Int
  currency    String   @default("EUR")
  category    String
  renewalDate DateTime
  // SQLite has no native enums; narrowed to the BillingCycle union in src/lib/subscriptions.ts.
  billingCycle String @default("monthly")
  // Only read for the "custom" cycle: charge every N months.
  intervalCount Int @default(1)
  // "active" | "paused" | "cancelled" (SubscriptionStatus in src/lib/subscriptions.ts).
  status        String @default("active")
  // Last day of a free trial; the first charge follows it.
  trialEndsAt   DateTime?
  // Anchoring the acknowledgement to a specific occurrence lets a dismissed
  // reminder revive itself once the renewal date rolls forward.
  reminderAckedOccurrence DateTime?
  reminderSnoozedUntil    DateTime?
  // The same, for the "trial ends" reminder.
  trialAckedAt            DateTime?
  trialSnoozedUntil       DateTime?
  // Free-form details, all optional.
  accountEmail            String?
  paymentMethod           String?
  notes                   String?
  // How much value you get from it, 1 (barely use it) to 5 (use it constantly); null = unrated.
  usageRating             Int?
  // When the status last became "cancelled"; null otherwise (and for older cancellations).
  cancelledAt             DateTime?
  priceChanges            PriceChange[]
}

// One row per edit that changed a subscription's price (same currency before and after).
model PriceChange {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // Integer minor units of `currency`, like Subscription.priceMinor.
  oldMinor       Int
  newMinor       Int
  currency       String
  changedAt      DateTime     @default(now())

  @@index([subscriptionId])
}

// A recurring household cost that isn't a subscription (water, electricity, insurance).
// The amount often varies, so `estimateMinor` is only a fallback for the average of the
// logged `BillPayment`s (see src/lib/bills.ts).
model Bill {
  id            String        @id @default(cuid())
  name          String
  // Free-text grouping such as "Utilities" or "Insurance".
  kind          String
  // Integer minor units of `currency`, like Subscription.priceMinor.
  estimateMinor Int
  currency      String        @default("EUR")
  // Same cycle fields as Subscription, so the shared date math applies. Never "once".
  billingCycle  String        @default("monthly")
  intervalCount Int           @default(1)
  // Anchor date for the due-date schedule; later due dates are derived from it.
  renewalDate   DateTime
  // "active" | "paused" | "cancelled"
  status        String        @default("active")
  notes         String?
  payments      BillPayment[]
}

// One row per actual amount paid for a bill.
model BillPayment {
  id          String   @id @default(cuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  // Integer minor units of `currency`.
  amountMinor Int
  currency    String
  paidOn      DateTime

  @@index([billId])
}

// A monthly spending cap for one category. Matched to subscriptions case-insensitively.
model CategoryBudget {
  id          String @id @default(cuid())
  // Trimmed, as the user typed it; unique ignoring case is enforced in the action.
  category    String @unique
  // Integer minor units of `currency`, like Settings.budgetMinor.
  budgetMinor Int
  currency    String
}

// Cached reference rates: how much of `currency` one euro buys.
model ExchangeRate {
  currency  String   @id
  perEur    Float
  fetchedAt DateTime
}

// Single-row table (id is always 1) until accounts exist.
model Settings {
  id              Int    @id @default(1)
  displayCurrency String @default("EUR")
  // Monthly spending cap in integer minor units of `budgetCurrency`; both null when unset.
  budgetMinor     Int?
  budgetCurrency  String?
}
