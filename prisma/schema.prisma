// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Subscription {
  id          String   @id @default(cuid())
  name        String
  price       Float
  category    String
  renewalDate DateTime
}
