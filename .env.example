DATABASE_URL="file:./dev.db"

# Email reminders (optional). Without SMTP_HOST and SMTP_FROM no email is sent.
# For local testing, a mail catcher such as MailHog or smtp4dev listens on port 1025 without a login.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user"
# SMTP_PASS="password"
# SMTP_FROM="Subscription Manager <you@example.com>"
